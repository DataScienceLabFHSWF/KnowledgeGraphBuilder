<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:kg="https://kg-workbench.local/ontology#"
         xml:base="https://example.com/ontology/">
  <owl:Ontology rdf:about="https://example.com/ontology/">
    <rdfs:label xml:lang="en">Decommissioning</rdfs:label>
    <rdfs:label xml:lang="de">Stilllegung</rdfs:label>
    <owl:versionInfo>V2</owl:versionInfo>
  </owl:Ontology>
  <owl:AnnotationProperty rdf:about="https://kg-workbench.local/ontology#module"/>
  <owl:AnnotationProperty rdf:about="https://kg-workbench.local/ontology#domainModule"/>
  <owl:AnnotationProperty rdf:about="https://kg-workbench.local/ontology#rangeModule"/>
  <owl:Class rdf:about="https://example.com/ontology/Activity">
    <rdfs:label xml:lang="en">Activity</rdfs:label>
    <rdfs:label xml:lang="de">Aktivitaet</rdfs:label>
    <rdfs:comment xml:lang="en">A planned decommissioning action or work item.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine geplante decommissioning action or work item.</rdfs:comment>
    <kg:module>Workflow and Change Measures</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Activity-Inventory">
    <rdfs:label xml:lang="en">Activity Inventory</rdfs:label>
    <rdfs:label xml:lang="de">Aktivitaetsinventar</rdfs:label>
    <rdfs:comment xml:lang="en">An estimated or measured inventory of radioactivity.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine estimated or Massnahmed inventory of radioactivity.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Assessment-Aspect">
    <rdfs:label xml:lang="en">Assessment Aspect</rdfs:label>
    <rdfs:label xml:lang="de">Bewertungsaspekt</rdfs:label>
    <rdfs:comment xml:lang="en">The discipline or aspect under which an assessment is performed.</rdfs:comment>
    <rdfs:comment xml:lang="de">Die discipline or aspect under which an Bewertung is performed.</rdfs:comment>
    <kg:module>Technical Safety Assessment</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Assessment-Result">
    <rdfs:label xml:lang="en">Assessment Result</rdfs:label>
    <rdfs:label xml:lang="de">Bewertungsergebnis</rdfs:label>
    <rdfs:comment xml:lang="en">The conclusion or result of an assessment.</rdfs:comment>
    <rdfs:comment xml:lang="de">Die conclusion or Ergebnis of an Bewertung.</rdfs:comment>
    <kg:module>Technical Safety Assessment</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Asset">
    <rdfs:label xml:lang="en">Asset</rdfs:label>
    <rdfs:label xml:lang="de">Anlage</rdfs:label>
    <rdfs:comment xml:lang="en">A physical or technical asset relevant for the measure.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine physische or technical asset relevant for the Massnahme.</rdfs:comment>
    <kg:module>Assets and Locations</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Building">
    <rdfs:label xml:lang="en">Building</rdfs:label>
    <rdfs:label xml:lang="de">Gebaeude</rdfs:label>
    <rdfs:comment xml:lang="en">A building that contains rooms and technical assets.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine building that enthaelt Raums and technical assets.</rdfs:comment>
    <kg:module>Assets and Locations</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Change-Measure">
    <rdfs:label xml:lang="en">Change Measure</rdfs:label>
    <rdfs:label xml:lang="de">Aenderungsmassnahme</rdfs:label>
    <rdfs:comment xml:lang="en">A planned change performed on systems, components, or rooms.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine geplante change performed on Systems, Komponentes, or Raums.</rdfs:comment>
    <kg:module>Workflow and Change Measures</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Component">
    <rdfs:label xml:lang="en">Component</rdfs:label>
    <rdfs:label xml:lang="de">Komponente</rdfs:label>
    <rdfs:comment xml:lang="en">A discrete technical component such as a vessel, line, or valve.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine discrete technical Komponente such as a vessel, line, or valve.</rdfs:comment>
    <kg:module>Assets and Locations</kg:module>
    <rdfs:subClassOf rdf:resource="https://example.com/ontology/Asset"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Constraint">
    <rdfs:label xml:lang="en">Constraint</rdfs:label>
    <rdfs:label xml:lang="de">Randbedingung</rdfs:label>
    <rdfs:comment xml:lang="en">A technical or operational restriction arising from the assessment.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine technische or operational restriction arising from the Bewertung.</rdfs:comment>
    <kg:module>Technical Safety Assessment</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Contamination-Status">
    <rdfs:label xml:lang="en">Contamination Status</rdfs:label>
    <rdfs:label xml:lang="de">Kontamination Status</rdfs:label>
    <rdfs:comment xml:lang="en">A classified contamination state of an asset, room, or material.</rdfs:comment>
    <rdfs:comment xml:lang="de">Ein klassifizierter contamination state of an asset, Raum, or Material.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Conversion-Measure">
    <rdfs:label xml:lang="en">Conversion Measure</rdfs:label>
    <rdfs:label xml:lang="de">Umruestung Massnahme</rdfs:label>
    <rdfs:comment xml:lang="en">A concrete conversion or decommissioning change to the plant.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine konkrete conversion or decommissioning change to the plant.</rdfs:comment>
    <kg:module>Measure Description</kg:module>
    <rdfs:subClassOf rdf:resource="https://example.com/ontology/Project-Measure"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Current-State">
    <rdfs:label xml:lang="en">Current State</rdfs:label>
    <rdfs:label xml:lang="de">Ist-Zustand</rdfs:label>
    <rdfs:comment xml:lang="en">A description of the present technical or spatial state before the measure.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine description of the present technical or spatial state vor the Massnahme.</rdfs:comment>
    <kg:module>Measure Description</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Dependency">
    <rdfs:label xml:lang="en">Dependency</rdfs:label>
    <rdfs:label xml:lang="de">Abhaengigkeit</rdfs:label>
    <rdfs:comment xml:lang="en">A dependency between workflow steps.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine Abhaengigkeit between Ablauf Schritts.</rdfs:comment>
    <kg:module>Workflow and Change Measures</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Disposal-Path">
    <rdfs:label xml:lang="en">Disposal Path</rdfs:label>
    <rdfs:label xml:lang="de">Entsorgung Pfad</rdfs:label>
    <rdfs:comment xml:lang="en">A planned route or destination for disposal or further treatment.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine geplante route or destination for disposal or further treatment.</rdfs:comment>
    <kg:module>Waste and Materials</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Document-Instance">
    <rdfs:label xml:lang="en">Document Instance</rdfs:label>
    <rdfs:label xml:lang="de">Dokumentinstanz</rdfs:label>
    <rdfs:comment xml:lang="en">One concrete NWA document created from a template.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine konkrete NWEine Dokument created from a Vorlage.</rdfs:comment>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Document-Template">
    <rdfs:label xml:lang="en">Document Template</rdfs:label>
    <rdfs:label xml:lang="de">Dokumentvorlage</rdfs:label>
    <rdfs:comment xml:lang="en">A recurring template for a specific NWA document family.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine wiederkehrende Vorlage for a specific NWEine Dokument family.</rdfs:comment>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Document-To-Adapt">
    <rdfs:label xml:lang="en">Document To Adapt</rdfs:label>
    <rdfs:label xml:lang="de">Dokument zu anpassen</rdfs:label>
    <rdfs:comment xml:lang="en">An existing document that must be adapted.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine existing Dokument that must be adapted.</rdfs:comment>
    <kg:module>Documentation and References</kg:module>
    <rdfs:subClassOf rdf:resource="https://example.com/ontology/Referenced-Document"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Document-To-Submit">
    <rdfs:label xml:lang="en">Document To Submit</rdfs:label>
    <rdfs:label xml:lang="de">Dokument zu einreichen</rdfs:label>
    <rdfs:comment xml:lang="en">A document that must be submitted later.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine Dokument that must be submitted later.</rdfs:comment>
    <kg:module>Documentation and References</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Documentation-Change">
    <rdfs:label xml:lang="en">Documentation Change</rdfs:label>
    <rdfs:label xml:lang="de">Dokumentation Aenderung</rdfs:label>
    <rdfs:comment xml:lang="en">A required change to existing documentation caused by the measure.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine erforderliche change to existing Dokumentation caverwendet by the Massnahme.</rdfs:comment>
    <kg:module>Documentation and References</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Dose-Rate">
    <rdfs:label xml:lang="en">Dose Rate</rdfs:label>
    <rdfs:label xml:lang="de">Dosisleistung</rdfs:label>
    <rdfs:comment xml:lang="en">A dose-rate value associated with a measurement or area.</rdfs:comment>
    <rdfs:comment xml:lang="de">Ein Dosisleistungswert, der mit einer Messung oder einem Bereich verknuepft ist.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Evidence-Item">
    <rdfs:label xml:lang="en">Evidence Item</rdfs:label>
    <rdfs:label xml:lang="de">Evidenz Element</rdfs:label>
    <rdfs:comment xml:lang="en">A supporting excerpt, table cell, or structured evidence element.</rdfs:comment>
    <rdfs:comment xml:lang="de">Ein unterstuetzender excerpt, table cell, or structured evidence element.</rdfs:comment>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Execution-Condition">
    <rdfs:label xml:lang="en">Execution Condition</rdfs:label>
    <rdfs:label xml:lang="de">Ausfuehrung Bedingung</rdfs:label>
    <rdfs:comment xml:lang="en">A condition that must hold before or during a workflow step.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine Bedingung that must hold vor or waehrend a Ablauf Schritt.</rdfs:comment>
    <kg:module>Workflow and Change Measures</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Field-Answer">
    <rdfs:label xml:lang="en">Field Answer</rdfs:label>
    <rdfs:label xml:lang="de">Feld Antwort</rdfs:label>
    <rdfs:comment xml:lang="en">A structured answer or extracted statement linked to a section.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine strukturierte answer or extracted statement linked to a Abschnitt.</rdfs:comment>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Future-Use">
    <rdfs:label xml:lang="en">Future Use</rdfs:label>
    <rdfs:label xml:lang="de">Zukuenftige Nutzung</rdfs:label>
    <rdfs:comment xml:lang="en">The planned future use of the affected room, area, or system.</rdfs:comment>
    <rdfs:comment xml:lang="de">Die geplant zukuenftige Nutzung of the affected Raum, area, or System.</rdfs:comment>
    <kg:module>Measure Description</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Impact">
    <rdfs:label xml:lang="en">Impact</rdfs:label>
    <rdfs:label xml:lang="de">Auswirkung</rdfs:label>
    <rdfs:comment xml:lang="en">A consequence of the planned measure on systems, activities, or safety.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine consequence of the geplant Massnahme on Systems, activities, or Sicherheit.</rdfs:comment>
    <kg:module>Technical Safety Assessment</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Impact-Assessment">
    <rdfs:label xml:lang="en">Impact Assessment</rdfs:label>
    <rdfs:label xml:lang="de">Auswirkung Bewertung</rdfs:label>
    <rdfs:comment xml:lang="en">An assessment of the consequences caused by a change measure.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine Bewertung of the consequences caverwendet by a change Massnahme.</rdfs:comment>
    <kg:module>Workflow and Change Measures</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Material">
    <rdfs:label xml:lang="en">Material</rdfs:label>
    <rdfs:label xml:lang="de">Material</rdfs:label>
    <rdfs:comment xml:lang="en">A handled material relevant for dismantling or waste generation.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine handled Material relevant for dismantling or Abfall generation.</rdfs:comment>
    <kg:module>Waste and Materials</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Measurement">
    <rdfs:label xml:lang="en">Measurement</rdfs:label>
    <rdfs:label xml:lang="de">Messung</rdfs:label>
    <rdfs:comment xml:lang="en">A concrete radiological measurement or survey event.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine konkrete radiologische Massnahmement or survey event.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Measurement-Method">
    <rdfs:label xml:lang="en">Measurement Method</rdfs:label>
    <rdfs:label xml:lang="de">Messung Methode</rdfs:label>
    <rdfs:comment xml:lang="en">A method used to obtain a sample or measurement.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine method verwendet to obtain a sample or Massnahmement.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Mitigation-Measure">
    <rdfs:label xml:lang="en">Mitigation Measure</rdfs:label>
    <rdfs:label xml:lang="de">Minderungs Massnahme</rdfs:label>
    <rdfs:comment xml:lang="en">A measure needed to reduce or control a risk or impact.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine Massnahme needed to reduce or control a risk or impact.</rdfs:comment>
    <kg:module>Technical Safety Assessment</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Monitoring-Requirement">
    <rdfs:label xml:lang="en">Monitoring Requirement</rdfs:label>
    <rdfs:label xml:lang="de">Ueberwachung Anforderung</rdfs:label>
    <rdfs:comment xml:lang="en">A required monitoring or surveillance activity.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine erforderliche monitoring or surveillance activity.</rdfs:comment>
    <kg:module>Technical Safety Assessment</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Preparation-Measure">
    <rdfs:label xml:lang="en">Preparation Measure</rdfs:label>
    <rdfs:label xml:lang="de">Vorbereitung Massnahme</rdfs:label>
    <rdfs:comment xml:lang="en">A preparatory action needed before the main dismantling work starts.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine preparatory action needed vor the main dismantling work starts.</rdfs:comment>
    <kg:module>Measure Description</kg:module>
    <rdfs:subClassOf rdf:resource="https://example.com/ontology/Project-Measure"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Project-Measure">
    <rdfs:label xml:lang="en">Project Measure</rdfs:label>
    <rdfs:label xml:lang="de">Projektmassnahme</rdfs:label>
    <rdfs:comment xml:lang="en">The overall undertaking described by the document.</rdfs:comment>
    <rdfs:comment xml:lang="de">Die overall undertaking described by the Dokument.</rdfs:comment>
    <kg:module>Measure Description</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Radiological-Characterization">
    <rdfs:label xml:lang="en">Radiological Characterization</rdfs:label>
    <rdfs:label xml:lang="de">Radiologische Charakterisierung</rdfs:label>
    <rdfs:comment xml:lang="en">A radiological description or interpretation of an asset, material, or waste stream.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine radiologische description or interpretation of an asset, Material, or Abfall stream.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Radionuclide">
    <rdfs:label xml:lang="en">Radionuclide</rdfs:label>
    <rdfs:label xml:lang="de">Radionuklid</rdfs:label>
    <rdfs:comment xml:lang="en">A nuclide relevant for characterization.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine nuclide relevant for Charakterisierung.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Raw-Waste-Estimate">
    <rdfs:label xml:lang="en">Raw Waste Estimate</rdfs:label>
    <rdfs:label xml:lang="de">Roh Abfall Schaetzung</rdfs:label>
    <rdfs:comment xml:lang="en">An estimated mass or quantity of raw waste.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine estimated mass or quantity of raw Abfall.</rdfs:comment>
    <kg:module>Waste and Materials</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Reference-Citation">
    <rdfs:label xml:lang="en">Reference Citation</rdfs:label>
    <rdfs:label xml:lang="de">Referenz Zitat</rdfs:label>
    <rdfs:comment xml:lang="en">A concrete citation of a referenced document inside a section.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine konkrete Zitat of a Referenzd Dokument inside a Abschnitt.</rdfs:comment>
    <kg:module>Documentation and References</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Referenced-Document">
    <rdfs:label xml:lang="en">Referenced Document</rdfs:label>
    <rdfs:label xml:lang="de">Referenced Dokument</rdfs:label>
    <rdfs:comment xml:lang="en">A document cited or reused by the NWA.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine Dokument cited or reverwendet by the NWA.</rdfs:comment>
    <kg:module>Documentation and References</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Room">
    <rdfs:label xml:lang="en">Room</rdfs:label>
    <rdfs:label xml:lang="de">Raum</rdfs:label>
    <rdfs:comment xml:lang="en">A room or spatial area referenced in the document.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine Raum or spatial area Referenzd in the Dokument.</rdfs:comment>
    <kg:module>Assets and Locations</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Sample">
    <rdfs:label xml:lang="en">Sample</rdfs:label>
    <rdfs:label xml:lang="de">Probe</rdfs:label>
    <rdfs:comment xml:lang="en">A sample taken or defined for radiological assessment.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine sample taken or defined for radiologische Bewertung.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Sampling-Plan">
    <rdfs:label xml:lang="en">Sampling Plan</rdfs:label>
    <rdfs:label xml:lang="de">Probenahme Plan</rdfs:label>
    <rdfs:comment xml:lang="en">A plan describing how samples are taken for characterization.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine plan describing how samples are taken for Charakterisierung.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Scope-Statement">
    <rdfs:label xml:lang="en">Scope Statement</rdfs:label>
    <rdfs:label xml:lang="de">Umfang Statement</rdfs:label>
    <rdfs:comment xml:lang="en">A statement defining the scope or boundary of the measure.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine statement defining the scope or boundary of the Massnahme.</rdfs:comment>
    <kg:module>Measure Description</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Section-Instance">
    <rdfs:label xml:lang="en">Section Instance</rdfs:label>
    <rdfs:label xml:lang="de">Abschnittsinstanz</rdfs:label>
    <rdfs:comment xml:lang="en">One concrete occurrence of a section inside a document instance.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine konkrete occurrence of a Abschnitt inside a Dokument instance.</rdfs:comment>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Section-Template">
    <rdfs:label xml:lang="en">Section Template</rdfs:label>
    <rdfs:label xml:lang="de">Abschnittsvorlage</rdfs:label>
    <rdfs:comment xml:lang="en">A reusable template for an expected chapter or subsection.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine wiederverwendbare Vorlage for an expected chapter or subAbschnitt.</rdfs:comment>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Section-Type">
    <rdfs:label xml:lang="en">Section Type</rdfs:label>
    <rdfs:label xml:lang="de">Abschnittstyp</rdfs:label>
    <rdfs:comment xml:lang="en">A semantic type for recurring sections such as workflow, waste, or safety assessment.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine semantic type for recurring Abschnitts such as Ablauf, Abfall, or Sicherheit Bewertung.</rdfs:comment>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Source-Anchor">
    <rdfs:label xml:lang="en">Source Anchor</rdfs:label>
    <rdfs:label xml:lang="de">Quellenanker</rdfs:label>
    <rdfs:comment xml:lang="en">A precise anchor into a source, such as a page, subsection, or table row.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine precise anchor into a source, such as a page, subAbschnitt, or table row.</rdfs:comment>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Storage-Need">
    <rdfs:label xml:lang="en">Storage Need</rdfs:label>
    <rdfs:label xml:lang="de">Lagerung Need</rdfs:label>
    <rdfs:comment xml:lang="en">A required storage volume, area, or capacity.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eine erforderliche storage volume, area, or capacity.</rdfs:comment>
    <kg:module>Waste and Materials</kg:module>
