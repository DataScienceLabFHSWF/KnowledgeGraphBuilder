  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Submission-Requirement">
    <rdfs:label xml:lang="en">Submission Requirement</rdfs:label>
    <rdfs:label xml:lang="de">Einreichungsanforderung</rdfs:label>
