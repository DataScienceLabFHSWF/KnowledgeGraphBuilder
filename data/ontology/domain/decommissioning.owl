<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:kg="https://kg-workbench.local/ontology#"
         xml:base="https://example.com/ontology/">
  <owl:Ontology rdf:about="https://example.com/ontology/">
    <rdfs:label>Decommissioning</rdfs:label>
    <owl:versionInfo>V2</owl:versionInfo>
  </owl:Ontology>
  <owl:AnnotationProperty rdf:about="https://kg-workbench.local/ontology#module"/>
  <owl:AnnotationProperty rdf:about="https://kg-workbench.local/ontology#domainModule"/>
  <owl:AnnotationProperty rdf:about="https://kg-workbench.local/ontology#rangeModule"/>
  <owl:Class rdf:about="https://example.com/ontology/Activity">
    <rdfs:label>Activity</rdfs:label>
    <rdfs:comment>A planned decommissioning action or work item.</rdfs:comment>
    <kg:module>Workflow and Change Measures</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Activity-Inventory">
    <rdfs:label>Activity Inventory</rdfs:label>
    <rdfs:comment>An estimated or measured inventory of radioactivity.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Assessment-Aspect">
    <rdfs:label>Assessment Aspect</rdfs:label>
    <rdfs:comment>The discipline or aspect under which an assessment is performed.</rdfs:comment>
    <kg:module>Technical Safety Assessment</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Assessment-Result">
    <rdfs:label>Assessment Result</rdfs:label>
    <rdfs:comment>The conclusion or result of an assessment.</rdfs:comment>
    <kg:module>Technical Safety Assessment</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Asset">
    <rdfs:label>Asset</rdfs:label>
    <rdfs:comment>A physical or technical asset relevant for the measure.</rdfs:comment>
    <kg:module>Assets and Locations</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Building">
    <rdfs:label>Building</rdfs:label>
    <rdfs:comment>A building that contains rooms and technical assets.</rdfs:comment>
    <kg:module>Assets and Locations</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Change-Measure">
    <rdfs:label>Change Measure</rdfs:label>
    <rdfs:comment>A planned change performed on systems, components, or rooms.</rdfs:comment>
    <kg:module>Workflow and Change Measures</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Component">
    <rdfs:label>Component</rdfs:label>
    <rdfs:comment>A discrete technical component such as a vessel, line, or valve.</rdfs:comment>
    <kg:module>Assets and Locations</kg:module>
    <rdfs:subClassOf rdf:resource="https://example.com/ontology/Asset"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Constraint">
    <rdfs:label>Constraint</rdfs:label>
    <rdfs:comment>A technical or operational restriction arising from the assessment.</rdfs:comment>
    <kg:module>Technical Safety Assessment</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Contamination-Status">
    <rdfs:label>Contamination Status</rdfs:label>
    <rdfs:comment>A classified contamination state of an asset, room, or material.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Conversion-Measure">
    <rdfs:label>Conversion Measure</rdfs:label>
    <rdfs:comment>A concrete conversion or decommissioning change to the plant.</rdfs:comment>
    <kg:module>Measure Description</kg:module>
    <rdfs:subClassOf rdf:resource="https://example.com/ontology/Project-Measure"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Current-State">
    <rdfs:label>Current State</rdfs:label>
    <rdfs:comment>A description of the present technical or spatial state before the measure.</rdfs:comment>
    <kg:module>Measure Description</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Dependency">
    <rdfs:label>Dependency</rdfs:label>
    <rdfs:comment>A dependency between workflow steps.</rdfs:comment>
    <kg:module>Workflow and Change Measures</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Disposal-Path">
    <rdfs:label>Disposal Path</rdfs:label>
    <rdfs:comment>A planned route or destination for disposal or further treatment.</rdfs:comment>
    <kg:module>Waste and Materials</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Document-Instance">
    <rdfs:label>Document Instance</rdfs:label>
    <rdfs:comment>One concrete NWA document created from a template.</rdfs:comment>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Document-Template">
    <rdfs:label>Document Template</rdfs:label>
    <rdfs:comment>A recurring template for a specific NWA document family.</rdfs:comment>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Document-To-Adapt">
    <rdfs:label>Document To Adapt</rdfs:label>
    <rdfs:comment>An existing document that must be adapted.</rdfs:comment>
    <kg:module>Documentation and References</kg:module>
    <rdfs:subClassOf rdf:resource="https://example.com/ontology/Referenced-Document"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Document-To-Submit">
    <rdfs:label>Document To Submit</rdfs:label>
    <rdfs:comment>A document that must be submitted later.</rdfs:comment>
    <kg:module>Documentation and References</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Documentation-Change">
    <rdfs:label>Documentation Change</rdfs:label>
    <rdfs:comment>A required change to existing documentation caused by the measure.</rdfs:comment>
    <kg:module>Documentation and References</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Dose-Rate">
    <rdfs:label>Dose Rate</rdfs:label>
    <rdfs:comment>A dose-rate value associated with a measurement or area.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Evidence-Item">
    <rdfs:label>Evidence Item</rdfs:label>
    <rdfs:comment>A supporting excerpt, table cell, or structured evidence element.</rdfs:comment>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Execution-Condition">
    <rdfs:label>Execution Condition</rdfs:label>
    <rdfs:comment>A condition that must hold before or during a workflow step.</rdfs:comment>
    <kg:module>Workflow and Change Measures</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Field-Answer">
    <rdfs:label>Field Answer</rdfs:label>
    <rdfs:comment>A structured answer or extracted statement linked to a section.</rdfs:comment>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Future-Use">
    <rdfs:label>Future Use</rdfs:label>
    <rdfs:comment>The planned future use of the affected room, area, or system.</rdfs:comment>
    <kg:module>Measure Description</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Impact">
    <rdfs:label>Impact</rdfs:label>
    <rdfs:comment>A consequence of the planned measure on systems, activities, or safety.</rdfs:comment>
    <kg:module>Technical Safety Assessment</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Impact-Assessment">
    <rdfs:label>Impact Assessment</rdfs:label>
    <rdfs:comment>An assessment of the consequences caused by a change measure.</rdfs:comment>
    <kg:module>Workflow and Change Measures</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Material">
    <rdfs:label>Material</rdfs:label>
    <rdfs:comment>A handled material relevant for dismantling or waste generation.</rdfs:comment>
    <kg:module>Waste and Materials</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Measurement">
    <rdfs:label>Measurement</rdfs:label>
    <rdfs:comment>A concrete radiological measurement or survey event.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Measurement-Method">
    <rdfs:label>Measurement Method</rdfs:label>
    <rdfs:comment>A method used to obtain a sample or measurement.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Mitigation-Measure">
    <rdfs:label>Mitigation Measure</rdfs:label>
    <rdfs:comment>A measure needed to reduce or control a risk or impact.</rdfs:comment>
    <kg:module>Technical Safety Assessment</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Monitoring-Requirement">
    <rdfs:label>Monitoring Requirement</rdfs:label>
    <rdfs:comment>A required monitoring or surveillance activity.</rdfs:comment>
    <kg:module>Technical Safety Assessment</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Preparation-Measure">
    <rdfs:label>Preparation Measure</rdfs:label>
    <rdfs:comment>A preparatory action needed before the main dismantling work starts.</rdfs:comment>
    <kg:module>Measure Description</kg:module>
    <rdfs:subClassOf rdf:resource="https://example.com/ontology/Project-Measure"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Project-Measure">
    <rdfs:label>Project Measure</rdfs:label>
    <rdfs:comment>The overall undertaking described by the document.</rdfs:comment>
    <kg:module>Measure Description</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Radiological-Characterization">
    <rdfs:label>Radiological Characterization</rdfs:label>
    <rdfs:comment>A radiological description or interpretation of an asset, material, or waste stream.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Radionuclide">
    <rdfs:label>Radionuclide</rdfs:label>
    <rdfs:comment>A nuclide relevant for characterization.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Raw-Waste-Estimate">
    <rdfs:label>Raw Waste Estimate</rdfs:label>
    <rdfs:comment>An estimated mass or quantity of raw waste.</rdfs:comment>
    <kg:module>Waste and Materials</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Reference-Citation">
    <rdfs:label>Reference Citation</rdfs:label>
    <rdfs:comment>A concrete citation of a referenced document inside a section.</rdfs:comment>
    <kg:module>Documentation and References</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Referenced-Document">
    <rdfs:label>Referenced Document</rdfs:label>
    <rdfs:comment>A document cited or reused by the NWA.</rdfs:comment>
    <kg:module>Documentation and References</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Room">
    <rdfs:label>Room</rdfs:label>
    <rdfs:comment>A room or spatial area referenced in the document.</rdfs:comment>
    <kg:module>Assets and Locations</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Sample">
    <rdfs:label>Sample</rdfs:label>
    <rdfs:comment>A sample taken or defined for radiological assessment.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Sampling-Plan">
    <rdfs:label>Sampling Plan</rdfs:label>
    <rdfs:comment>A plan describing how samples are taken for characterization.</rdfs:comment>
    <kg:module>Radiological Characterization</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Scope-Statement">
    <rdfs:label>Scope Statement</rdfs:label>
    <rdfs:comment>A statement defining the scope or boundary of the measure.</rdfs:comment>
    <kg:module>Measure Description</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Section-Instance">
    <rdfs:label>Section Instance</rdfs:label>
    <rdfs:comment>One concrete occurrence of a section inside a document instance.</rdfs:comment>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Section-Template">
    <rdfs:label>Section Template</rdfs:label>
    <rdfs:comment>A reusable template for an expected chapter or subsection.</rdfs:comment>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Section-Type">
    <rdfs:label>Section Type</rdfs:label>
    <rdfs:comment>A semantic type for recurring sections such as workflow, waste, or safety assessment.</rdfs:comment>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Source-Anchor">
    <rdfs:label>Source Anchor</rdfs:label>
    <rdfs:comment>A precise anchor into a source, such as a page, subsection, or table row.</rdfs:comment>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Storage-Need">
    <rdfs:label>Storage Need</rdfs:label>
    <rdfs:comment>A required storage volume, area, or capacity.</rdfs:comment>
    <kg:module>Waste and Materials</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Submission-Requirement">
    <rdfs:label>Submission Requirement</rdfs:label>
    <rdfs:comment>A requirement that a document or record be submitted.</rdfs:comment>
    <kg:module>Documentation and References</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Subsystem">
    <rdfs:label>Subsystem</rdfs:label>
    <rdfs:comment>A smaller functional part of a system.</rdfs:comment>
    <kg:module>Assets and Locations</kg:module>
    <rdfs:subClassOf rdf:resource="https://example.com/ontology/System"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/System">
    <rdfs:label>System</rdfs:label>
    <rdfs:comment>A plant system relevant for operation, dismantling, or assessment.</rdfs:comment>
    <kg:module>Assets and Locations</kg:module>
    <rdfs:subClassOf rdf:resource="https://example.com/ontology/Asset"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Tagged-Item">
    <rdfs:label>Tagged Item</rdfs:label>
    <rdfs:comment>A source-system tag or identifier assigned to a component or system.</rdfs:comment>
    <kg:module>Assets and Locations</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Target-State">
    <rdfs:label>Target State</rdfs:label>
    <rdfs:comment>A description of the intended technical or spatial state after the measure.</rdfs:comment>
    <kg:module>Measure Description</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Technical-Assessment">
    <rdfs:label>Technical Assessment</rdfs:label>
    <rdfs:comment>A structured safety or technical assessment statement in the document.</rdfs:comment>
    <kg:module>Technical Safety Assessment</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Technical-Discipline">
    <rdfs:label>Technical Discipline</rdfs:label>
    <rdfs:comment>A technical domain such as ventilation, fire protection, or electrical systems.</rdfs:comment>
    <kg:module>Assets and Locations</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Waste-Package">
    <rdfs:label>Waste Package</rdfs:label>
    <rdfs:comment>A package or container used for waste handling.</rdfs:comment>
    <kg:module>Waste and Materials</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Waste-Stream">
    <rdfs:label>Waste Stream</rdfs:label>
    <rdfs:comment>A classified waste category resulting from the measure.</rdfs:comment>
    <kg:module>Waste and Materials</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Workflow">
    <rdfs:label>Workflow</rdfs:label>
    <rdfs:comment>An ordered set of steps representing the planned execution.</rdfs:comment>
    <kg:module>Workflow and Change Measures</kg:module>
  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Workflow-Step">
    <rdfs:label>Workflow Step</rdfs:label>
    <rdfs:comment>One ordered execution step in the planned workflow.</rdfs:comment>
    <kg:module>Workflow and Change Measures</kg:module>
    <rdfs:subClassOf rdf:resource="https://example.com/ontology/Activity"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://example.com/ontology/Activity-Inventory/activity-inventory-value">
    <rdfs:label>activity inventory value</rdfs:label>
    <rdfs:comment>Numeric value of the activity inventory.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.com/ontology/Activity-Inventory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <kg:module>Radiological Characterization</kg:module>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.com/ontology/Activity-Inventory/activity-inventory-unit">
    <rdfs:label>activity inventory unit</rdfs:label>
    <rdfs:comment>Unit of the activity inventory value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.com/ontology/Activity-Inventory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <kg:module>Radiological Characterization</kg:module>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.com/ontology/Assessment-Result/result-label">
    <rdfs:label>result label</rdfs:label>
    <rdfs:comment>Short textual label of the assessment result.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.com/ontology/Assessment-Result"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <kg:module>Technical Safety Assessment</kg:module>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.com/ontology/Asset/asset-identifier">
    <rdfs:label>asset identifier</rdfs:label>
    <rdfs:comment>Technical identifier used for an asset or component.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.com/ontology/Asset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <kg:module>Assets and Locations</kg:module>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.com/ontology/Constraint/constraint-level">
    <rdfs:label>constraint level</rdfs:label>
    <rdfs:comment>Severity or binding level of a constraint.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.com/ontology/Constraint"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <kg:module>Technical Safety Assessment</kg:module>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.com/ontology/Document-Instance/document-identifier">
    <rdfs:label>document identifier</rdfs:label>
    <rdfs:comment>Identifier of the concrete NWA document.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.com/ontology/Document-Instance"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.com/ontology/Documentation-Change/documentation-status">
    <rdfs:label>documentation status</rdfs:label>
    <rdfs:comment>Status of the required documentation change.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.com/ontology/Documentation-Change"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <kg:module>Documentation and References</kg:module>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.com/ontology/Dose-Rate/dose-rate-value">
    <rdfs:label>dose rate value</rdfs:label>
    <rdfs:comment>Numeric dose-rate value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.com/ontology/Dose-Rate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <kg:module>Radiological Characterization</kg:module>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.com/ontology/Dose-Rate/dose-rate-unit">
    <rdfs:label>dose rate unit</rdfs:label>
    <rdfs:comment>Unit of the dose-rate value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.com/ontology/Dose-Rate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <kg:module>Radiological Characterization</kg:module>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.com/ontology/Execution-Condition/condition-status">
    <rdfs:label>condition status</rdfs:label>
    <rdfs:comment>Indicates whether the condition is planned, confirmed, or pending.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.com/ontology/Execution-Condition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <kg:module>Workflow and Change Measures</kg:module>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.com/ontology/Field-Answer/review-status">
    <rdfs:label>review status</rdfs:label>
    <rdfs:comment>Review state of an extracted answer.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.com/ontology/Field-Answer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <kg:module>Document Structure and Evidence</kg:module>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.com/ontology/Future-Use/future-use-label">
    <rdfs:label>future use label</rdfs:label>
    <rdfs:comment>Human-readable label of the intended future use.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.com/ontology/Future-Use"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <kg:module>Measure Description</kg:module>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.com/ontology/Project-Measure/measure-title">
    <rdfs:label>measure title</rdfs:label>
    <rdfs:comment>Short title of the undertaking.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.com/ontology/Project-Measure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <kg:module>Measure Description</kg:module>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.com/ontology/Radionuclide/name">
    <rdfs:label>name</rdfs:label>
    <rdfs:domain rdf:resource="https://example.com/ontology/Radionuclide"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <kg:module>Radiological Characterization</kg:module>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.com/ontology/Radionuclide/elementSymbol">
    <rdfs:label>elementSymbol</rdfs:label>
    <rdfs:domain rdf:resource="https://example.com/ontology/Radionuclide"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <kg:module>Radiological Characterization</kg:module>
  </owl:DatatypeProperty>
