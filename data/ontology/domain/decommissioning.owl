    <rdfs:label xml:lang="en">step code</rdfs:label>
    <rdfs:label xml:lang="de">Schrittcode</rdfs:label>
    <rdfs:comment xml:lang="en">Number or code used in the document for a workflow step.</rdfs:comment>
