  </owl:Class>
  <owl:Class rdf:about="https://example.com/ontology/Storage-Need">
    <rdfs:label xml:lang="en">Storage Need</rdfs:label>
    <rdfs:label xml:lang="de">Lagerbedarf</rdfs:label>
