  <owl:ObjectProperty rdf:about="https://example.com/ontology/depends-on-step">
    <rdfs:label xml:lang="en">depends on step</rdfs:label>
    <rdfs:label xml:lang="de">Abhängigkeit von Schritt</rdfs:label>
    <rdfs:comment xml:lang="en">States that a workflow step depends on another step.</rdfs:comment>
