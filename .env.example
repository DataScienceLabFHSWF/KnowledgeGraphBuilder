# KnowledgeGraphBuilder – Environment Variables
# Copy this file to `.env` and adjust for your setup.
#
# STANDALONE: uses container names kgb-neo4j, kgb-qdrant, etc.
# PLATFORM:   uses kgplatform-neo4j, kgplatform-qdrant, etc.
#             (env vars are overridden by KGPlatform's docker-compose.yml)

# ── Infrastructure ─────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
FUSEKI_ADMIN_PASSWORD=admin

# ── Data stores ────────────────────────────────────────────────
QDRANT_COLLECTION=kgbuilder
FUSEKI_DATASET=kgbuilder

# ── Model serving ──────────────────────────────────────────────
# Set LLM_BACKEND to "ollama" or "vllm". COMPOSE_PROFILES activates the
# matching inference services; leave the backend as Ollama for current setup.
LLM_BACKEND=ollama
COMPOSE_PROFILES=${LLM_BACKEND}
LLM_TEMPERATURE=
LLM_TOP_P=0.9
LLM_SEED=
LLM_CHAT_TEMPLATE_KWARGS={}
LLM_CACHE_ENABLED=true
# Ollama models are pulled automatically on `docker compose up`.
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding
OLLAMA_DECISION_MODEL=
# Host port for Ollama (standalone only)
OLLAMA_PORT=11435
# Ollama >= 0.35 is required for decision-model /v1/systemone support.
OLLAMA_IMAGE=ollama/ollama:0.35.0

# vLLM uses separate generation and embedding model servers. The embedding
# model must match the model used for the existing Qdrant vectors.
VLLM_IMAGE=vllm/vllm-openai:v0.29.0
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
VLLM_API_KEY=EMPTY
VLLM_GPU_DEVICE=0
VLLM_EMBEDDING_GPU_DEVICE=0
VLLM_EMBEDDING_GPU_MEMORY_UTILIZATION=0.05

# Kolibri is served through Aleph Alpha's plugin image (supported vLLM 0.29).
# To run it, set LLM_BACKEND=vllm, COMPOSE_PROFILES=kolibri,
# VLLM_MODEL=Aleph-Alpha/Kolibri-1, and VLLM_BASE_URL=http://kgb-vllm:8000/v1.
KOLIBRI_VLLM_IMAGE=ghcr.io/aleph-alpha/aleph-alpha-inference@sha256:ac93d782890eb942dd59afa7cee9fa1e681d09f63a0036b21ea7664a254ed7d5
KOLIBRI_MODEL_REVISION=e52eb4627d11516b0c01de49210ab5a4e4061444
KOLIBRI_GPU_DEVICE=0
KOLIBRI_MAX_MODEL_LEN=32768
KOLIBRI_GPU_MEMORY_UTILIZATION=0.9

# ── API service ────────────────────────────────────────────────
UVICORN_PORT=8001
# Required for GET /api/extract/{runId}/status and /results
KGBUILDER_API_KEY=

# Cross-service URLs (leave empty for standalone, set for platform)
GRAPHQA_API_URL=
ONTOLOGY_API_URL=

# ── Weights & Biases (optional) ────────────────────────────────
WANDB_PROJECT=kg-builder
WANDB_API_KEY=

# ── Misc ───────────────────────────────────────────────────────
KGBUILDER_ENV=development
